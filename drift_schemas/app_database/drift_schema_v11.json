  "fixed_sql": [
    {
      "name": "subscribers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"subscribers\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL CHECK (LENGTH(TRIM(name)) > 0), \"email\" TEXT NULL, \"phone\" TEXT NULL, \"postal_address\" TEXT NULL, \"postal_code\" TEXT NULL, \"created_at\" TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP, \"updated_at\" TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP, \"archived_at\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "audit_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"audit_logs\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"subscriber_id\" INTEGER NOT NULL REFERENCES subscribers (id), \"previous_values\" TEXT NULL, \"updated_values\" TEXT NOT NULL, \"modified_at\" TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP);"
        }
      ]
    },
    {
      "name": "subscriptions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"subscriptions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"subscriber_id\" INTEGER NOT NULL REFERENCES subscribers (id), \"edition\" TEXT NOT NULL CHECK (edition IN ('online', 'offline')), \"plan_type\" TEXT NOT NULL CHECK (plan_type IN ('annual', 'multi_year', 'lifetime')), \"duration_years\" INTEGER     NOT NULL CHECK (\n      (plan_type = 'annual' AND duration_years = 1) OR\n      (plan_type = 'multi_year' AND duration_years > 1 AND duration_years <= 50) OR\n      (plan_type = 'lifetime' AND duration_years = 15)\n    )\n  , \"start_date\" TEXT NOT NULL, \"expiry_date\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP, \"updated_at\" TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP, \"archived_at\" TEXT NULL);"
        }
      ]
    },
